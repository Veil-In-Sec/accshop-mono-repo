# ---------------------------------------------------------------------------
# Root environment example — copy values into each app's env file:
#   apps/api/.env      (server-side secrets + database)
#   apps/web/.env      (public API URL)
# ---------------------------------------------------------------------------

# PostgreSQL (used by apps/api)
DATABASE_URL="postgresql://user:password@host:5432/accshop"
SHADOW_DATABASE_URL="postgresql://user:password@host:5432/accshop_shadow"

# Better Auth (used by apps/api) — the PUBLIC origin where the NestJS API runs
BETTER_AUTH_URL="http://107.172.127.198:4000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Admin panel password (used by apps/api)
ADMIN_PASSWORD="change-me"

# TOTP vault key (used by apps/api to encrypt customer 2FA secrets).
# Generate with: openssl rand -hex 32. Never rotate without re-encrypting.
TOTP_VAULT_KEY="replace-with-openssl-rand-hex-32"

# Allowed browser origins of the Next.js frontend (comma separated, used by apps/api for CORS/trusted origins)
WEB_ORIGINS="http://localhost:3000,http://107.172.127.198:3000"

# Public API URL consumed by the BROWSER (apps/web) — same origin as the web app
# so Next.js rewrites proxy /api/* to the API (no :4000 exposure needed).
NEXT_PUBLIC_API_URL="http://107.172.127.198:3000"
# Server-to-server URL used by Next.js server components/actions (localhost is fine)
API_SERVER_URL="http://localhost:4000"
