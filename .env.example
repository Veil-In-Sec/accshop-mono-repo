# ---------------------------------------------------------------------------
# Root environment example — single Next.js app (merged API + web):
#   apps/web/.env      (all server secrets + database + public URLs)
# Never commit real secrets. Prod values live only on the server + CI secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (Prisma, lib/server/db.ts)
# On the SERVER (.env via File Manager / Selector env vars) use the
# server-local URL, e.g. "postgresql://user:pass@localhost:5432/accshop".
# From YOUR machine (migrations only, Essential plan has no SSH) use the
# HostSeba tunnel: terminal 1 `ssh -L 5433:127.0.0.200:5432
# accshopo@103.65.138.26 -N`, terminal 2
# DATABASE_URL="postgresql://user:pass@localhost:5433/accshop" npm run db:migrate
DATABASE_URL="postgresql://user:password@host:5432/accshop"
SHADOW_DATABASE_URL="postgresql://user:password@host:5432/accshop_shadow"

# Better Auth — canonical public origin of the app (auth cookies same-origin)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Admin panel password (admin_session HMAC, proxy.ts + lib/server/admin.ts)
ADMIN_PASSWORD="change-me"

# TOTP vault key (AES-256, encrypts customer 2FA secrets).
# Generate with: openssl rand -hex 32. Never rotate without re-encrypting.
TOTP_VAULT_KEY="replace-with-openssl-rand-hex-32"

# Allowed browser origins (better-auth trustedOrigins)
# Prod: "https://accshop.online". Dev: "http://localhost:3000".
WEB_ORIGINS="http://localhost:3000"

# Canonical public origin of the web app (SEO, sitemap, metadata).
# Prod: "https://accshop.online". Dev: "http://localhost:3000".
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-to-server base URL for server actions/fetch (same app, localhost fine)
API_SERVER_URL="http://127.0.0.1:3000"
