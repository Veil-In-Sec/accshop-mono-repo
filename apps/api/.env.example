DATABASE_URL="postgresql://user:password@host:5432/accshop"
SHADOW_DATABASE_URL="postgresql://user:password@host:5432/accshop_shadow"
BETTER_AUTH_URL="http://127.0.0.1:4000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_PASSWORD="change-me"
WEB_ORIGINS="http://localhost:3000"
PORT=4000

# TOTP vault key (AES-256, 64 hex chars) for encrypting customer 2FA secrets.
# Generate with: openssl rand -hex 32
# Never rotate without re-encrypting totp_keys.secret_encrypted.
TOTP_VAULT_KEY="replace-with-openssl-rand-hex-32"

# BulkMail API key (X-API-Key) — configure via Admin > Settings > BulkMail API Gateway
BULKMAIL_API_KEY=""
