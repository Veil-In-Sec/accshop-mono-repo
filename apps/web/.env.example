# Merged single app: API lives in app/api/* locally (no :4000, no rewrites).
# The browser uses same-origin /api/* directly.
# Canonical public origin of the web app (metadata, sitemap, robots, SEO).
# Prod: "https://accshop.online". Dev: "http://localhost:3000".
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-to-server base URL for server actions/fetch (same app).
# Use 127.0.0.1 (not "localhost") on hosts where "localhost" resolves to IPv6 ::1.
API_SERVER_URL="http://127.0.0.1:3000"

# Optional extra dev origins for `next dev` (comma separated).
ALLOWED_DEV_ORIGINS="localhost,127.0.0.1"

# Must match the API's values so the web middleware can verify the admin cookie.
# Generate with: openssl rand -hex 32. Never commit real values.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_PASSWORD="change-me"

# GraphMail code reader (tools.dongvanfb.net/api/graph_messages).
# Overrides the built-in default when set.
# GRAPH_MAIL_API_URL="https://tools.dongvanfb.net/api/graph_messages"
