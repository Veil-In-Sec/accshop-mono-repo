# Public URL the BROWSER uses for the API. Same origin as the web app so that
# Next.js rewrites proxy /api/* to the API (no :4000 exposure needed).
NEXT_PUBLIC_API_URL="http://107.172.127.198:3000"

# URL used by Next.js server components / server actions to reach the API directly (server-side).
# Use 127.0.0.1 (not "localhost") on hosts where "localhost" resolves to IPv6 ::1.
API_SERVER_URL="http://127.0.0.1:4000"

# Must match the API's values so the web middleware can verify the admin cookie
BETTER_AUTH_SECRET="8f4c1d9e7a2b5c6e3f0a8d4b9c1e7f2a6d3b8c5e0f9a4d7b2c6e1f3a5d8b0c9e"
